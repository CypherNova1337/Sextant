+import pytest
+
+from rich.text import Text
+
+
+def test_count_basic():
+    assert Text("foo bar foo").count("foo") == 2
+    assert Text("aaaa").count("aa") == 2
+    assert Text("hello").count("x") == 0
+
+
+def test_count_case():
+    text = Text("Foo foo FOO")
+    assert text.count("foo") == 1
+    assert text.count("foo", case_sensitive=False) == 3
+
+
+def test_count_text_argument():
+    assert Text.from_markup("[b]ab[/b]ab").count(Text("ab")) == 2
+
+
+def test_count_ignores_markup_styles():
+    assert Text.from_markup("[red]x[/red] [blue]x[/blue]").count("x") == 2
+
+
+def test_count_empty():
+    with pytest.raises(ValueError):
+        Text("abc").count("")
