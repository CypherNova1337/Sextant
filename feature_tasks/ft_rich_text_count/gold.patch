+    def count(self, sub: Union[str, "Text"], case_sensitive: bool = True) -> int:
+        """Count the non-overlapping occurrences of a substring in the plain text.
+
+        Args:
+            sub (Union[str, Text]): Substring to count.
+            case_sensitive (bool, optional): Match case. Defaults to True.
+
+        Returns:
+            int: Number of occurrences.
+        """
+        needle = sub.plain if isinstance(sub, Text) else sub
+        if not needle:
+            raise ValueError("sub must not be empty")
+        haystack = self.plain
+        if not case_sensitive:
+            needle = needle.lower()
+            haystack = haystack.lower()
+        return haystack.count(needle)
+
