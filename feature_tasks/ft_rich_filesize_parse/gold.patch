 """
 
-__all__ = ["decimal"]
+__all__ = ["decimal", "parse"]
 
+import re
+from decimal import ROUND_HALF_EVEN, Decimal
 from typing import Iterable, List, Optional, Tuple
 
 
@@ -86,3 +88,19 @@ def decimal(
         precision=precision,
         separator=separator,
     )
+
+
+_SIZE_UNITS = {"kB": 1, "MB": 2, "GB": 3, "TB": 4, "PB": 5, "EB": 6, "ZB": 7, "YB": 8}
+_SIZE_RE = re.compile(r"^([0-9][0-9,]*(?:\.[0-9]+)?)\s*(bytes?|[kMGTPEZY]B)$")
+
+
+def parse(text: str) -> int:
+    """Convert a size produced by :func:`decimal` back into a number of bytes."""
+    match = _SIZE_RE.match(text.strip())
+    if match is None:
+        raise ValueError(f"invalid file size: {text!r}")
+    number, unit = match.groups()
+    value = Decimal(number.replace(",", ""))
+    if unit not in ("byte", "bytes"):
+        value *= 1000 ** _SIZE_UNITS[unit]
+    return int(value.to_integral_value(rounding=ROUND_HALF_EVEN))
