+import pytest
+
+from requests.models import Response
+
+
+def make(code):
+    r = Response()
+    r.status_code = code
+    return r
+
+
+@pytest.mark.parametrize("code, client, server", [
+    (200, False, False), (399, False, False), (400, True, False), (404, True, False),
+    (499, True, False), (500, False, True), (503, False, True), (599, False, True), (600, False, False),
+])
+def test_props(code, client, server):
+    r = make(code)
+    assert r.is_client_error is client
+    assert r.is_server_error is server
+
+
+def test_none():
+    r = Response()
+    assert r.is_client_error is False
+    assert r.is_server_error is False
