@@ -0,0 +1,31 @@
+from fastapi import APIRouter, FastAPI
+from fastapi.health import add_health_route
+from fastapi.testclient import TestClient
+
+
+def test_default():
+    app = FastAPI()
+    assert add_health_route(app) is None
+    client = TestClient(app)
+    response = client.get("/health")
+    assert response.status_code == 200
+    assert response.json() == {"status": "ok"}
+    assert "/health" not in client.get("/openapi.json").json().get("paths", {})
+
+
+def test_custom_path_and_status():
+    app = FastAPI()
+    add_health_route(app, "/ready", status="ready", include_in_schema=True)
+    client = TestClient(app)
+    assert client.get("/ready").json() == {"status": "ready"}
+    assert "/ready" in client.get("/openapi.json").json()["paths"]
+    assert client.get("/health").status_code == 404
+
+
+def test_router():
+    router = APIRouter()
+    add_health_route(router, "/ping")
+    app = FastAPI()
+    app.include_router(router, prefix="/api")
+    client = TestClient(app)
+    assert client.get("/api/ping").json() == {"status": "ok"}
